# Copy to .env for local work. Never commit real values. Production secrets live only in the Render and Vercel dashboards.
ENV=development
DATABASE_URL=sqlite:///./baton_dev.db
JWT_SECRET=dev-secret-change-me
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# Module-prefixed variables (each owner declares theirs here through a contract-change issue)
INGEST_MAX_UPLOAD_MB=10
LLM_PROVIDER=replay
LLM_MODEL=
LLM_API_KEY=
REVIEW_REQUIRE_RESOLVED_CONFLICTS=true
HANDOVER_DEFAULT_PLAN_BUCKETS=day_1,week_1,month_1

# Frontend (set in Vercel as VITE_API_URL)
VITE_API_URL=http://localhost:8000
